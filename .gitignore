# Gage Root .gitignore

# Flutter / Dart
gage-app/.dart_tool/
gage-app/.flutter-plugins*
gage-app/.pub/
gage-app/.pub-cache/
gage-app/build/
gage-app/android/app/debug/
gage-app/android/app/profile/
gage-app/android/app/release/
gage-app/doc/api/

# Cloudflare Wrangler & Node
gage-cloud/.wrangler/
gage-cloud/node_modules/
checklist_web/.wrangler/
checklist_web/node_modules/
checklist_web_backup/

# Release binaries (Uploaded directly to GitHub Releases)
release_apks/
*.apk
*.so
/lib/


# Scratch / debug image dumps in root and app
*.png
!gage-app/assets/**/*.png
!gage-cloud/**/*.png
!checklist_web/**/*.png

# Logs & temp
*.log
*.tmp
/*.xml
audit_dump.json
.DS_Store
Thumbs.db
full_user_snippet.html
user_html_css_ref.txt
evidence_gofood_merchant/

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Local scratch scripts, media dumps, and session logs
scratch/
gage-app/scratch/
.agents/
anti-slop/
PROJECT.md
*.figcraft
*.mp4
*.aac
*.wav
launch_*.bat
record_demo.ps1
